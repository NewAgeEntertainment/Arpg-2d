  m_Script: {fileID: 11500000, guid: 6b113340aad1aa74ca7d2d443beff4ea, type: 3}
  m_Name: after sex
  m_EditorClassIdentifier: 
  dialogueSequence:
  - dialogueSentence: '(blushes hard) I hope that was enough you? '
    npcName: Elaina
    npcImage: {fileID: 21300000, guid: f32e158f66d3750469b8d4f972a7197f, type: 3}
  - dialogueSentence: 'Mmm. Good enough, for now, but I may need your help in the
      future. '
    npcName: Lioncard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: (blushes) Hmph!
    npcName: Elaina
    npcImage: {fileID: 21300000, guid: f32e158f66d3750469b8d4f972a7197f, type: 3}
  - dialogueSentence: Now, how about we find your sister.
    npcName: Lioncard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: Yes.
    npcName: Elaina
    npcImage: {fileID: 21300000, guid: f32e158f66d3750469b8d4f972a7197f, type: 3}
  - dialogueSentence: Let's go to the place where you and your sister got seperated.
    npcName: Lioncard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: Yes, it's to the east of here. Near the Flower garden.
    npcName: Elaina
    npcImage: {fileID: 21300000, guid: f32e158f66d3750469b8d4f972a7197f, type: 3}
