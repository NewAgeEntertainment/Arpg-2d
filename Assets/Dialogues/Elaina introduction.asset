%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b113340aad1aa74ca7d2d443beff4ea, type: 3}
  m_Name: Elaina introduction
  m_EditorClassIdentifier: 
  dialogueSequence:
  - dialogueSentence: You Scandrels, Where have you taken my sister?
    npcName: Elaina
    npcImage: {fileID: 21300000, guid: f32e158f66d3750469b8d4f972a7197f, type: 3}
  - dialogueSentence: Settle down Girl, we wouldn't want to hurt you.
    npcName: Bandit
    npcImage: {fileID: 21300000, guid: d1fe2b36154a99a49aa2f9f2dfabeca4, type: 3}
  - dialogueSentence: Yeah, now be a good girl and come with us.
    npcName: Bandit #2
    npcImage: {fileID: 21300000, guid: 8b1b791800b841746849debb0b9edbef, type: 3}
  - dialogueSentence: Never.
    npcName: Elania
    npcImage: {fileID: 21300000, guid: f32e158f66d3750469b8d4f972a7197f, type: 3}
  - dialogueSentence: Hey, you guy got room for one more?
    npcName: Licard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: Who the hell are you?
    npcName: Bandits
    npcImage: {fileID: 21300000, guid: d1fe2b36154a99a49aa2f9f2dfabeca4, type: 3}
  - dialogueSentence: Just a guy trying to get a piece of the action.
    npcName: Lioncard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: Well fuck off, there's no piggybacking over here.
    npcName: Bandits #2
    npcImage: {fileID: 21300000, guid: 8b1b791800b841746849debb0b9edbef, type: 3}
  - dialogueSentence: Come on guys, you know it ain't no fun if we all can't have
      some.
    npcName: Lioncard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: Last time, no.
    npcName: Bandits
    npcImage: {fileID: 21300000, guid: d1fe2b36154a99a49aa2f9f2dfabeca4, type: 3}
  - dialogueSentence: Well that's too bad, now I have to take her for myself.
    npcName: Lioncard
    npcImage: {fileID: 21300000, guid: e9b967a3b79c94143b4eb6b9e33cb3cf, type: 3}
  - dialogueSentence: Just try it asshole.
    npcName: Bandits
    npcImage: {fileID: 21300000, guid: d1fe2b36154a99a49aa2f9f2dfabeca4, type: 3}
